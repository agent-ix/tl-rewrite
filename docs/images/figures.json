{
  "style": "ix-docs",
  "data": {
    "enabled": {"from": "tally", "path": "corpus/rules/manifest.json", "pointer": "/cases", "filters": [{"key": "disposition", "equals": "enabled"}]},
    "excluded": {"from": "tally", "path": "corpus/rules/manifest.json", "pointer": "/cases", "filters": [{"key": "disposition", "equals": "excluded"}]},
    "fam_bool": {"from": "tally", "path": "corpus/rules/manifest.json", "pointer": "/cases", "filters": [{"key": "disposition", "equals": "enabled"}, {"key": "id", "prefix": "bool."}]},
    "fam_neg": {"from": "tally", "path": "corpus/rules/manifest.json", "pointer": "/cases", "filters": [{"key": "disposition", "equals": "enabled"}, {"key": "id", "prefix": "neg."}]},
    "fam_temporal": {"from": "tally", "path": "corpus/rules/manifest.json", "pointer": "/cases", "filters": [{"key": "disposition", "equals": "enabled"}, {"key": "id", "prefix": "temporal."}]},
    "families": {"from": "sum", "of": ["fam_bool", "fam_neg", "fam_temporal"]},
    "families_cover_enabled": {"from": "expect", "of": "families", "like": "enabled"}
  },
